{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "./vendor/nx.ts/packages/typescript-preset/src/plugin.ts",
      "options": {
        "tsgo": false,
        "tsdown": true,
        "biome": true,
        "oxlint": false
      }
    },
    "./tools/plugins/cdk8s/src/plugin.ts"
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "synth": {
      "dependsOn": ["^build"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": ["default", "!{projectRoot}/**/*.test.ts"]
  }
}
