# Required
SSH_AUTHORIZED_KEYS="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIYourKeyHere user@example"
# Required (base64-encoded — generate with: openssl rand -base64 32)
OAUTH_COOKIE_SECRET=""

# Required — your OpenShift project and cluster apps domain
# (oc get ingress.config/cluster -o jsonpath='{.spec.domain}')
# Left empty on purpose: synthesis fails until you fill them in.
NAMESPACE=
APPS_DOMAIN=

# Optional (defaults shown)
WORKSPACE_IMAGE=ghcr.io/theplenkov-infra/devcontainer/workspace:latest
WORKSPACE_IMAGE_DIGEST=unknown
PVC_SIZE=30Gi
PVC_STORAGE_CLASS=gp3
WORKSPACE_NAME=workspace
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_KEEP=3

# Optional: GHCR pull secret (base64 docker config JSON)
GHCR_PULL_SECRET=

# Optional: R2 backup credentials (all or none — if any are set, all must be)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
RESTIC_PASSWORD=
