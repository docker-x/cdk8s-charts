# Required
SSH_AUTHORIZED_KEYS="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIYourKeyHere user@example"
OAUTH_COOKIE_SECRET="generate-a-32-char-random-string-here"

# Optional (defaults shown)
NAMESPACE=theplenkov-dev
WORKSPACE_IMAGE=ghcr.io/theplenkov-infra/devcontainer/workspace:latest
WORKSPACE_IMAGE_DIGEST=unknown
APPS_DOMAIN=apps.rm3.7wse.p1.openshiftapps.com
PVC_SIZE=30Gi
PVC_STORAGE_CLASS=gp3
WORKSPACE_NAME=workspace
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_KEEP=3

# Optional: GHCR pull secret (base64 docker config JSON)
GHCR_PULL_SECRET=

# Optional: R2 backup credentials (all or none)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=workspace-backups
RESTIC_PASSWORD=
